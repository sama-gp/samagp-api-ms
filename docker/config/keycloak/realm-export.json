{
  "realm": "samagp",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "gp",
        "description": "Role pour les annonceurs"
      },
      {
        "name": "client",
        "description": "Role pour les clients"
      },
      {
        "name": "default-roles-samagp",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": ["gp", "client"]
        }
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "registrationWithRole",
      "description": "Registration flow with role assignment",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-profile",
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "registration-password",
          "requirement": "REQUIRED",
          "priority": 20
        },
        {
          "authenticator": "registration-user-creation",
          "requirement": "REQUIRED",
          "priority": 30
        },
        {
          "authenticator": "user-role-assignment",
          "requirement": "REQUIRED",
          "priority": 40,
          "authenticatorConfig": "role-assignment-config"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "role-assignment-config",
      "config": {
        "role.attribute.name": "role"
      }
    }
  ],
  "registrationFlow": "registrationWithRole",
  "users": [
    {
      "username": "samagp",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sama",
      "lastName": "GP",
      "email": "samagp2023@gmail.com",
      "credentials": [
        {
          "type": "password",
          "value": "samagp",
          "temporary": false
        }
      ],
      "realmRoles": [
        "gp",
        "client"
      ],
      "attributes": {
        "phoneNumber": ["+1234567890"],
        "address": ["Adresse par défaut"]
      }
    },
    {
      "username": "ovd",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Omar",
      "lastName": "VD",
      "email": "ovd@gmail.com",
      "credentials": [
        {
          "type": "password",
          "value": "ovd",
          "temporary": false
        }
      ],
      "realmRoles": [
        "client"
      ],
      "attributes": {
        "phoneNumber": ["+1234567890"],
        "address": ["Ouakam"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "samagp-api",
      "secret": "samagp-secret",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "redirectUris": [
        "http://localhost:8082/*"
      ],
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "webOrigins": [
        "*"
      ]
    },
    {
      "clientId": "samagp-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["*"],
      "directAccessGrantsEnabled": true
    }
  ],
  "browserFlow": "browser",
  "resetCredentialsFlow": "reset credentials",
  "clientAuthenticationFlow": "clients"
}